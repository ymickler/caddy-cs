{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ymickler/renovate-config:dockerfile",
    "local>ymickler/renovate-config:github-action"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG BOUNCER_VERSION=(?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "description": "Image contents (Caddy + bouncer): offer patch and minor as separate PRs, so a patch is never held back by a pending minor",
      "matchManagers": ["dockerfile", "custom.regex"],
      "separateMinorPatch": true
    },
    {
      "description": "Override preset: only patch updates of the image contents are automerged",
      "matchManagers": ["dockerfile", "custom.regex"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "image patch updates",
      "groupSlug": "image-patch",
      "automerge": true
    },
    {
      "description": "Override preset: minor updates of the image contents need a manual merge",
      "matchManagers": ["dockerfile", "custom.regex"],
      "matchUpdateTypes": ["minor"],
      "groupName": "image minor updates",
      "groupSlug": "image-minor",
      "automerge": false
    },
    {
      "description": "Major updates of the image contents need a manual merge",
      "matchManagers": ["dockerfile", "custom.regex"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
